# Solana Mainnet
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
# Keep the Helius API key server-side; never use NEXT_PUBLIC_ for this URL.
SOLANA_MAINNET_RPC_URL=https://mainnet.helius-rpc.com/?api-key=
# Zolius Lock and Swap are not deployed on Mainnet.

# Supabase Postgres connection for Zolius pages.
# Use the Supabase Session Pooler URI (port 5432) or Transaction Pooler URI (port 6543).
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Use PGSSLMODE=disable only for local Postgres; Supabase requires TLS.
DATABASE_URL=
PGSSLMODE=require
# Backwards-compatible aliases; DATABASE_URL takes precedence.
ZOLIUS_DATABASE_URL=
WAITLIST_DATABASE_URL=
# Optional Cloudflare Turnstile bot protection for the Agents waitlist.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
