# Solana Network
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Uniswap V4 Dependencies
NEXT_PUBLIC_V4_POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951
NEXT_PUBLIC_V4_PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3
NEXT_PUBLIC_WETH=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73

# Veil Protocol Deployments (Auto-populated on deploy)
NEXT_PUBLIC_VEIL_TREASURY=
NEXT_PUBLIC_VEIL_ATTESTATION_REGISTRY=
NEXT_PUBLIC_VEIL_HOOK=
NEXT_PUBLIC_VEIL_SHIELD_ROUTER=
NEXT_PUBLIC_PRIVACY_POOL_ETH=
NEXT_PUBLIC_SHIELDED_VERIFIER=
NEXT_PUBLIC_VEIL_CREATE2_DEPLOYER=
# Canonical VeilToken address (empty until the token deploys)
NEXT_PUBLIC_VEIL_TOKEN=

# Deployment Signer (CLI Only - Do NOT expose in frontend)
# PRIVATE_KEY=0x...

# Zolius Solana Privacy Rings — Devnet
# NEXT_PUBLIC values are shipped to the browser. Use a dedicated Devnet Helius key, never a wallet/deployer secret.
# Keep the existing NEXT_PUBLIC_CHAIN_ID=46630 setting for Devnet mode.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_DEVNET_RPC_URL=
NEXT_PUBLIC_SOLANA_WS_URL=
# Optional endpoint overrides; leave blank to use the unified Helius Devnet RPC URL above.
NEXT_PUBLIC_SOLANA_INDEXER_URL=
NEXT_PUBLIC_SOLANA_PROVER_URL=
# Zolius Lock and Swap are deployed to Devnet (development verifier keys).
NEXT_PUBLIC_SOLANA_LOCK_PROGRAM_ID=AJok8ztWjxcbeFDLAWRmY11fCvp8mJJpbrvpUs3UmoZP
NEXT_PUBLIC_SOLANA_SWAP_PROGRAM_ID=HQioSDqtsHSz2LzdHZXYShA8Jgi19Sxxh92M2rKVMC7u

# Solana Devnet deployer: base58-encoded 64-byte secret key. Keep local; never add to Vercel.
# Local deployment only. Do not add this variable to Vercel.
ZOLIUS_DEVNET_DEPLOYER_PRIVATE_KEY=
