    "test:shield": "node scripts/mainnet-shield-e2e.mjs",
    "compile:veiltoken": "node scripts/compile-veiltoken.mjs",
    "deploy:veiltoken": "node scripts/deploy-veiltoken.mjs --testnet",
    "deploy:veiltoken:mainnet": "node scripts/deploy-veiltoken.mjs --mainnet",
    "wire:treasury": "node scripts/wire-treasury-testnet.mjs",
