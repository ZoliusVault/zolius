{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "zoliusvault.tech" }],
      "destination": "https://www.zoliusvault.tech/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/shield-artifacts/(.*)",
      "headers": [{ "key": "Content-Type", "value": "application/octet-stream" }]
    }
  ]
}
